# Example configuration file for GitLab CI/CD workflow
# Copy this file to veracode-devcount-gitlab.yml and update with your settings
# Or place it in the repository root as veracode-devcount-gitlab.yml

global-network:
  # Optional: SSL Certificate Configuration
  # ssl:
  #   reject-unauthorized: true
  #   ca-file: "/path/to/ca-certificate.pem"
  
  # Optional: Proxy Configuration
  # proxy:
  #   host: "proxy.company.com"
  #   port: 8080
  #   protocol: "http"
  #   auth:
  #     username: "proxy-user"
  #     password: "proxy-pass"
  
  # Optional: Rate Limiting Configuration
  rate-limit:
    requests-per-hour: 4000
    requests-per-minute: 60
    delay-between-requests: 1000
    max-retries: 5
    backoff-multiplier: 2

dev-count:
  - ci-system: "gitlab"
    # Token will be overridden by GITLAB_TOKEN environment variable if set
    # You can set a placeholder here or leave it empty
    ci-token: "placeholder-will-be-overridden"
    domain: "https://gitlab.com/api/v4"
    # For self-hosted GitLab, use: "https://your-gitlab-instance.com/api/v4"
    # Optional: regex pattern for email filtering
    # regex: "/gitlab\\.com$/i"
    # Optional: regex file path
    # regex-file: "/path/to/regex/file"

